{
  "name": "blockpass-backend",
  "version": "1.0.0",
  "description": "BlockPass Event and Ticketing System API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "node --test -r ts-node/register tests/*.test.ts",
    "seed": "ts-node scripts/seed.ts",
    "stellar:setup": "ts-node scripts/setupStellar.ts",
    "stellar:mint-demo": "ts-node scripts/mintDemo.ts",
    "stellar:e2e": "ts-node scripts/e2eTestnet.ts",
    "stellar:init-contract": "ts-node scripts/initializeContract.ts",
    "user:create": "ts-node scripts/createUser.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^13.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
