PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/blockpass
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Stellar / Soroban ticket minting
# See contracts/ticket-nft/README.md for how to deploy the contract and
# obtain these values.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_CONTRACT_ID=
# Secret key of BlockPass's custodial issuer/admin account. Keep this out of
# version control in real deployments (this file is only an .example).
STELLAR_ISSUER_SECRET=
# 32-byte key (as base64) used to encrypt custodial user secret keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WALLET_ENCRYPTION_KEY=
