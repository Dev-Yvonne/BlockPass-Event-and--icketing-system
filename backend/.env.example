PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/blockpass
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Stellar testnet ticket issuance. `npm run stellar:setup` fills these in.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Platform account that pays fees and routes each ticket to its attendee.
STELLAR_DISTRIBUTOR_SECRET=
# Issues BPUSD, the test stablecoin used for Stellar payments at checkout.
STELLAR_STABLECOIN_ISSUER_SECRET=
# 32-byte base64 key that encrypts custodial issuer and attendee secrets at rest.
WALLET_ENCRYPTION_KEY=
CHECKOUT_RATE_LIMIT_PER_MINUTE=20

# Soroban ticket-nft contract (gate check-in phase, not used by Round 1).
# See contracts/ticket-nft/README.md.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_CONTRACT_ID=
STELLAR_ISSUER_SECRET=
